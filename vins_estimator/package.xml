<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vins_estimator</name>
  <version>0.0.0</version>
  <description>VINS-RGBD-FAST estimator (ROS2 port)</description>
  <maintainer email="qintonguav@gmail.com">qintong</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>camera_model</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml-cpp</depend>

  <!-- 시스템 라이브러리(rosdep 키) — CMake 의 find_package 와 같은 목록. Yocto 레시피 DEPENDS 도 이 목록을 따른다 [SW1-1959]
       sophus 는 적지 않는다: rosdep 키 sophus = ros-humble-sophus(1.22)라 다른 판을 끌어온다.
       요구 판 1.24.6 은 cmake/SophusPin.cmake 가 검사하고, Yocto 는 전용 레시피(SRCREV d0b7315a)로 넣는다. -->
  <depend>eigen</depend>
  <depend>libceres-dev</depend>
  <depend>boost</depend>
  <depend>libopencv-dev</depend>
  <!-- fmt 는 적지 않는다: Sophus 1.24.6 헤더는 fmt 를 쓰지 않는다(파이썬 바인딩만 씀), VINS 소스도 안 쓴다 -->

  <!-- launch/edie/*.launch.py 가 쓰는 파이썬 의존 (SW1-1948: 기본 경로를 share 로 찾는다) -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_ros</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-opencv</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
