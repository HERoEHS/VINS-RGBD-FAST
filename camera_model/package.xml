<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_model</name>
  <version>0.0.0</version>
  <description>The camera_model package (ROS2 port)</description>
  <maintainer email="dvorak@todo.todo">dvorak</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 시스템 라이브러리(rosdep 키) — CMake find_package 와 같은 목록 [SW1-1959] (Boost → boost 오타 정정) -->
  <depend>boost</depend>
  <depend>eigen</depend>
  <depend>libceres-dev</depend>
  <depend>libopencv-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
